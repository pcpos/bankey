<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/drawerLayout"
    android:background="@color/screenbg"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@null"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include layout="@layout/header_lay"/>
        <include layout="@layout/tabs"/>
        <ScrollView
            android:id="@+id/ScrollView01"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/addBenLay"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <View
                        android:id="@+id/vwcrdno1"
                        android:background="@color/gray"
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_marginTop="10dp"/>
                    <com.google.android.material.textfield.TextInputLayout
                        android:gravity="center_vertical"
                        android:paddingTop="4dp"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <EditText
                            android:textColor="@color/fieldsTxtClr"
                            android:textColorHint="@color/hintClr"
                            android:gravity="center"
                            android:id="@+id/edtBankNameSpinner"
                            android:background="@null"
                            android:focusable="false"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="15dp"
                            android:hint="@string/mmBanFtDrophint"
                            android:editable="false"
                            android:drawableLeft="@drawable/dropdownarr"
                            android:drawablePadding="10dp"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <View
                        android:id="@+id/vewbankName"
                        android:background="@color/gray"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"/>
                    <LinearLayout
                        android:gravity="center"
                        android:layout_gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/llytftdirectMobile"
                        android:background="@null"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="65dp"
                        android:layout_marginLeft="15dp"
                        android:layout_marginRight="0dp">
                        <ImageView
                            android:layout_gravity="center"
                            android:id="@+id/imagvewftdirectMobile"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:src="@drawable/newmobile"/>
                        <com.google.android.material.textfield.TextInputLayout
                            android:gravity="center_vertical"
                            android:id="@+id/txtinputmobile"
                            android:paddingTop="4dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <EditText
                                android:textColor="@color/fieldsTxtClr"
                                android:textColorHint="@color/hintClr"
                                android:gravity="center"
                                android:id="@+id/edtMobilenum"
                                android:background="@null"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_margin="15dp"
                                android:text="@string/mbnoPrefx"
                                android:hint="@string/mbnoHint"
                                android:singleLine="true"
                                android:maxLength="@integer/mbnoMaxLen"
                                android:drawablePadding="10dp"
                                android:inputType="number"/>
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                    <View
                        android:id="@+id/vewMobileNum"
                        android:background="@color/gray"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"/>
                    <com.google.android.material.textfield.TextInputLayout
                        android:gravity="center_vertical"
                        android:paddingTop="4dp"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <EditText
                            android:textColor="@color/fieldsTxtClr"
                            android:textColorHint="@color/hintClr"
                            android:gravity="center"
                            android:id="@+id/edtBenfNickName"
                            android:background="@null"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="15dp"
                            android:hint="@string/nickNameHint"
                            android:singleLine="true"
                            android:maxLength="@integer/nameMaxLen"
                            android:drawableLeft="@drawable/manicon"
                            android:drawablePadding="10dp"
                            android:inputType="textCapWords"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <View
                        android:id="@+id/vewEdtNickName"
                        android:background="@color/gray"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"/>
                    <com.google.android.material.textfield.TextInputLayout
                        android:gravity="center_vertical"
                        android:paddingTop="4dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <EditText
                            android:textColor="@color/fieldsTxtClr"
                            android:textColorHint="@color/hintClr"
                            android:gravity="center"
                            android:id="@+id/edtCardNo"
                            android:background="@null"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="15dp"
                            android:text=""
                            android:hint="@string/enter_card_no_hint"
                            android:singleLine="true"
                            android:maxLength="@integer/otheBankCardMaxLen"
                            android:drawableLeft="@drawable/card"
                            android:drawablePadding="10dp"
                            android:inputType="number"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <View
                        android:id="@+id/vwcrdno"
                        android:background="@color/gray"
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"/>
                    <com.google.android.material.textfield.TextInputLayout
                        android:gravity="center_vertical"
                        android:paddingTop="4dp"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <EditText
                            android:textColor="@color/fieldsTxtClr"
                            android:textColorHint="@color/hintClr"
                            android:gravity="center"
                            android:id="@+id/edtConfCardNo"
                            android:background="@null"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="15dp"
                            android:text=""
                            android:hint="@string/conf_card_no_hint"
                            android:singleLine="true"
                            android:maxLength="@integer/otheBankCardMaxLen"
                            android:drawableLeft="@drawable/card"
                            android:drawablePadding="10dp"
                            android:inputType="number"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <View
                        android:id="@+id/vwconfcrdno"
                        android:background="@color/gray"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"/>
                    <include layout="@layout/buttons_lay"/>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="200dp"/>
                </LinearLayout>
                <TableLayout
                    android:id="@+id/othFtBenefListTablay"
                    android:background="@null"
                    android:padding="20dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:shrinkColumns="*"/>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
    <RelativeLayout
        android:layout_gravity="left"
        android:id="@+id/drawerPane"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include layout="@layout/slidmenu_default_lay"/>
    </RelativeLayout>
</androidx.drawerlayout.widget.DrawerLayout>
