<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:layout_gravity="center"
        android:id="@+id/card_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        card_view:cardCornerRadius="2dp"
        card_view:contentPaddingTop="10dp">
        <RelativeLayout
            android:orientation="vertical"
            android:background="@null"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:orientation="horizontal"
                android:id="@+id/accSum_mainRow"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/accTypeIcon"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginRight="10dp"
                    android:src="@drawable/savingsaccount"
                    android:layout_alignParentRight="true"
                    android:contentDescription="@string/app_name"/>
                <RelativeLayout
                    android:id="@+id/accSum_subRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:layout_marginRight="5dp"
                    android:layout_toLeftOf="@+id/accTypeIcon"
                    android:layout_toRightOf="@+id/accBalLay"
                    android:layout_centerVertical="true">
                    <TextView
                        android:textSize="15sp"
                        android:textStyle="normal"
                        android:textColor="@color/accType"
                        android:id="@+id/accType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/accNo"
                        android:id="@+id/accNo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_below="@+id/accType"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/accBalLay"
                    android:paddingRight="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true">
                    <ImageView
                        android:id="@+id/currIcon"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/sdg"
                        android:contentDescription="@string/app_name"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/green"
                        android:gravity="left"
                        android:id="@+id/accBal"
                        android:paddingLeft="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10000.00"
                        android:layout_below="@+id/currIcon"
                        android:layout_centerVertical="true"/>
                </RelativeLayout>
            </RelativeLayout>
            <View
                android:id="@+id/rowView"
                android:background="@color/gray"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginTop="5dp"
                android:layout_below="@+id/accSum_mainRow"/>
            <RelativeLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:layout_below="@+id/rowView">
                <include layout="@layout/uae_stmt_row_qrgen_viewstmt_lay"/>
            </RelativeLayout>
        </RelativeLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
