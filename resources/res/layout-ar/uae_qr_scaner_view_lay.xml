<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.dlazaro66.qrcodereaderview.QRCodeReaderView
        android:id="@+id/qrCodeReaderView"
        android:layout_width="@dimen/qrscan_width"
        android:layout_height="@dimen/qrscan_height"
        android:layout_marginLeft="50dp"
        android:layout_marginTop="30dp"
        android:layout_marginRight="50dp"
        android:layout_marginBottom="40dp"
        android:layout_centerInParent="true"
        android:layout_centerHorizontal="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/iconsLay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/scanImgMarginRight"
        android:layout_alignParentLeft="true"
        android:layout_centerInParent="true"
        android:layout_centerVertical="true">
        <ImageView
            android:id="@+id/onOffFlash"
            android:visibility="visible"
            android:layout_width="@dimen/qrScanerhewe"
            android:layout_height="@dimen/qrScanerhewe"
            android:src="@drawable/electricityandflash"/>
        <ImageView
            android:id="@+id/scanGrallay"
            android:layout_width="@dimen/qrScanerhewe"
            android:layout_height="@dimen/qrScanerhewe"
            android:layout_marginTop="10dp"
            android:src="@drawable/gallerry"/>
        <ImageView
            android:id="@+id/scanHistry"
            android:visibility="gone"
            android:layout_width="@dimen/qrScanerhewe"
            android:layout_height="@dimen/qrScanerhewe"
            android:layout_marginTop="10dp"
            android:src="@drawable/listofscans"/>
    </LinearLayout>
</RelativeLayout>
