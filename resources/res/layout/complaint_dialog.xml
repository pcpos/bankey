<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="250dp"
    android:layout_marginLeft="10dp"
    android:layout_marginRight="10dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/llytpopupheader"
        android:background="@drawable/dialog_headerbg_shape"
        android:layout_width="match_parent"
        android:layout_height="40dp">
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#fff"
            android:gravity="center"
            android:id="@+id/drpdown_dialog_title"
            android:paddingLeft="10dp"
            android:paddingTop="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="20dp"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/lis_rel_one11"
        android:background="@drawable/dialog_bg"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/lis_rel_one"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.textfield.TextInputLayout
                android:gravity="center_vertical"
                android:id="@+id/remarkTextInpt"
                android:paddingTop="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <EditText
                    android:textColor="@color/fieldsTxtClr"
                    android:textColorHint="@color/hintClr"
                    android:id="@+id/edtRemarks"
                    android:background="@null"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="15dp"
                    android:hint="@string/remarksHint"
                    android:singleLine="true"
                    android:maxLength="@integer/commentMaxLen"
                    android:drawableRight="@drawable/comment"
                    android:drawablePadding="10dp"
                    android:inputType="text"/>
            </com.google.android.material.textfield.TextInputLayout>
            <View
                android:id="@+id/vewComments"
                android:background="@color/gray"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_below="@+id/remarkTextInpt"/>
        </RelativeLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingBottom="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true">
            <include layout="@layout/buttons_lay"/>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
